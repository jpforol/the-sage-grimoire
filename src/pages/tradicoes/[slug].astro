---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatBlock from '../../components/StatBlock.astro';
import { getCategory } from '../../data/categories';
import { url } from '../../utils/url';

export async function getStaticPaths() {
  const entries = await getCollection('codex', ({ data }) => data.category === 'tradicoes' && !data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.id.split('/').pop() },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const category = getCategory('tradicoes');

// Fetch all spells belonging to this tradition
const magias = await getCollection('codex', ({ data }) =>
  data.category === 'magias' && data.stats?.tradicao === entry.data.stats?.tradicao && !data.draft
);

// Sort spells by title
magias.sort((a, b) => a.data.title.localeCompare(b.data.title, 'pt-BR'));

// Group by rank (Novato, Especialista, Mestre)
const RANK_ORDER = ['Novato', 'Especialista', 'Mestre'];
const groups = new Map<string, typeof magias>();
for (const rank of RANK_ORDER) {
  groups.set(rank, magias.filter(m => m.data.stats?.rank === rank));
}
---

<BaseLayout title={entry.data.title} description={entry.data.summary}>
  <article data-pagefind-body>
    <nav class="breadcrumb" aria-label="Localização">
      <a href={url('/')}>Grimório</a>
      &nbsp;›&nbsp;
      <a href={url('/tradicoes/')}>{category?.label}</a>
    </nav>

    <header class="entry-header">
      <h1>{entry.data.title}</h1>
      <p class="summary">{entry.data.summary}</p>
      {
        entry.data.tags.length > 0 && (
          <div class="tags">
            {entry.data.tags.map((tag) => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        )
      }
    </header>

    <StatBlock stats={entry.data.stats} />

    <div class="entry-body">
      <Content />
    </div>

    {/* Spells grouped by rank */}
    {
      Array.from(groups.entries()).map(([rank, rankSpells]) =>
        rankSpells.length > 0 ? (
          <section class="spell-group" key={rank}>
            <h2>{rank}</h2>
            <ul class="spell-list">
              {rankSpells.map((spell) => (
                <li>
                  <a href={url(`/magias/${spell.id.split('/').pop()}/`)}>
                    {spell.data.title}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ) : null
      )
    }

    {
      entry.data.source && (
        <p class="entry-source">
          Fonte: {entry.data.source.book}, página {entry.data.source.page}
        </p>
      )
    }
  </article>
</BaseLayout>

<style>
  .spell-group {
    margin: 2rem 0 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-soft);
  }

  .spell-group h2 {
    font-size: 1.4rem;
    margin-bottom: 1rem;
  }

  .spell-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .spell-list li {
    margin: 0;
  }

  .spell-list a {
    display: block;
    padding: 0.5rem 0.75rem;
    background: var(--surface);
    border: 1px solid var(--border-soft);
    border-radius: var(--radius);
    color: var(--gold);
    text-decoration: none;
    transition: border-color 0.15s ease;
  }

  .spell-list a:hover {
    border-color: var(--gold);
  }
</style>
