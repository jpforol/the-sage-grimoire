---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatBlock from '../../components/StatBlock.astro';
import { getCategory } from '../../data/categories';
import { url } from '../../utils/url';

export async function getStaticPaths() {
  const entries = await getCollection('codex', ({ data }) => data.category === 'tradicoes' && !data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.id.split('/').pop() },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const category = getCategory('tradicoes');

// Fetch all spells belonging to this tradition
const magias = await getCollection('codex', ({ data }) =>
  data.category === 'magias' && data.stats?.tradicao === entry.data.stats?.tradicao && !data.draft
);

// Sort spells by title
magias.sort((a, b) => a.data.title.localeCompare(b.data.title, 'pt-BR'));

// Render all spell markdown bodies
const renderedSpells = await Promise.all(
  magias.map(async (spell) => ({
    spell,
    Content: (await render(spell)).Content,
  }))
);

// Group by rank
const RANK_ORDER = ['Novato', 'Especialista', 'Mestre'];
const groups = new Map(
  RANK_ORDER.map((rank) => [
    rank,
    renderedSpells.filter(({ spell }) => spell.data.stats?.rank === rank),
  ])
);
---

<BaseLayout title={entry.data.title} description={entry.data.summary}>
  <article data-pagefind-body>
    <nav class="breadcrumb" aria-label="Localização">
      <a href={url('/')}>Grimório</a>
      &nbsp;›&nbsp;
      <a href={url('/tradicoes/')}>{category?.label}</a>
    </nav>

    <header class="entry-header">
      <h1>{entry.data.title}</h1>
      <p class="summary">{entry.data.summary}</p>
      {
        entry.data.tags.length > 0 && (
          <div class="tags">
            {entry.data.tags.map((tag) => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        )
      }
    </header>

    <div class="entry-body">
      <Content />
    </div>

    {/* Spells grouped by rank — full content inline */}
    {
      Array.from(groups.entries()).map(([rank, rankSpells]) =>
        rankSpells.length > 0 ? (
          <section class="spell-rank-group">
            <h2>Magias de {rank}</h2>
            {rankSpells.map(({ spell, Content: SpellContent }) => (
              <article class="spell-entry">
                <h3 class="spell-name">{spell.data.title}</h3>
                <StatBlock stats={spell.data.stats} />
                <div class="spell-body">
                  <SpellContent />
                </div>
              </article>
            ))}
          </section>
        ) : null
      )
    }

    {
      entry.data.source && (
        <p class="entry-source">
          Fonte: {entry.data.source.book}, página {entry.data.source.page}
        </p>
      )
    }
  </article>
</BaseLayout>

<style>
  .spell-rank-group {
    margin: 2.5rem 0 0;
    padding-top: 1.5rem;
    border-top: 2px solid var(--gold);
  }

  .spell-rank-group h2 {
    font-size: 1.5rem;
    margin-bottom: 1.5rem;
    color: var(--gold-bright);
  }

  .spell-entry {
    margin: 0 0 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border-soft);
  }

  .spell-entry:last-child {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
  }

  .spell-name {
    font-size: 1.2rem;
    margin: 0 0 0.5rem;
    color: var(--gold);
  }

  .spell-body {
    margin-top: 0.75rem;
  }
</style>
